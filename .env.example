# Copy to .env on the server and fill in. NEVER commit .env or paste it in chat.

# --- Claude (judges clips + writes trend briefs) — console.anthropic.com → API keys
ANTHROPIC_API_KEY=
JUDGE_MODEL=claude-opus-5-5
SCREEN_MODEL=claude-haiku-5-5     # cheap first pass; empty = judge everything with JUDGE_MODEL
SCREEN_MIN=5

# --- Telegram (approval queue + posting reminders) — @BotFather → /newbot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=                 # message the bot, it replies with your id; comma-separate several people

# --- Trend radar — Google Cloud console → enable "YouTube Data API v3" → Credentials → API key
YOUTUBE_API_KEY=
TREND_KEYWORDS=GTA 6,GTA VI
TREND_SUBREDDITS=GTA6,GTA,GTAVI
TREND_MIN=60

# --- Real-time clipper (chat spikes + 10-min rolling recording → clip in ~2-3 min)
RT_PRE_ROLL_S=70                   # seconds kept before the chat spike (chat reacts late)
RT_POST_ROLL_S=20                  # seconds after (the punchline)
RT_Z_THRESHOLD=4.5                 # spike sensitivity: higher = fewer, bigger moments (and lower Claude bill)
RT_MIN_HYPE_SHARE=0.4              # share of chat messages that must be KEKW/LMAO/CLIP IT/????? etc.
RT_QUALITY=1080p60,1080p,720p60,720p,best

# --- Catch-up clipper (loudness + transcript on the VOD; catches moments chat missed)
POLL_MIN=30
WORKERS=4                          # streamers processed in parallel (≈ cores / 4)
MIN_SCORE=5                        # Claude score needed to reach your phone
AUTO_APPROVE_SCORE=11              # 11 = you approve everything (week 1). Later e.g. 9 = post 9+/10 automatically
WHISPER_MODEL=small

# --- Publisher
TIMEZONE=Europe/London
POST_HOURS=8-23
POST_SPACING_MIN=150               # minutes between posts on the same account set
REPORT_HOUR=9                      # daily scout report
